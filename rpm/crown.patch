+    HOOK_INDIRECT(memalign),
     HOOK_DIRECT_NO_DEBUG(valloc),
     HOOK_DIRECT_NO_DEBUG(pvalloc),
     HOOK_DIRECT(fread),
@@ -3288,7 +3381,7 @@ static struct _hook hooks_mm[] = {
     HOOK_DIRECT_NO_DEBUG(dprintf),
